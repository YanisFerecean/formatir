{
  "name": "formatir",
  "version": "0.1.0",
  "description": "Privacy-first behaviour analytics for web forms: rage clicks, dead clicks, hesitation, field effort, drop-off and client errors in <5 KB.",
  "keywords": [
    "analytics",
    "forms",
    "ux",
    "rage-click",
    "dead-click",
    "telemetry",
    "form-analytics",
    "privacy"
  ],
  "homepage": "https://yanisferecean.github.io/formatir/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YanisFerecean/formatir.git",
    "directory": "packages/formatir-sdk"
  },
  "bugs": {
    "url": "https://github.com/YanisFerecean/formatir/issues"
  },
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.global.js",
  "jsdelivr": "./dist/index.global.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup && node scripts/size.mjs",
    "dev": "tsup --watch",
    "size": "node scripts/size.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=18"
  }
}
