{
  "name": "formatir",
  "version": "0.1.0",
  "description": "Privacy-first behaviour analytics for web forms: rage clicks, dead clicks, hesitation, field effort, drop-off and client errors in ~5 KB.",
  "keywords": [
    "analytics",
    "forms",
    "ux",
    "rage-click",
    "dead-click",
    "telemetry",
    "form-analytics",
    "privacy"
  ],
  "homepage": "https://yanisferecean.github.io/formatir/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YanisFerecean/formatir.git",
    "directory": "packages/formatir-sdk"
  },
  "bugs": {
    "url": "https://github.com/YanisFerecean/formatir/issues"
  },
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.global.js",
  "jsdelivr": "./dist/index.global.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./extras": {
      "import": {
        "types": "./dist/extras.d.mts",
        "default": "./dist/extras.mjs"
      },
      "require": {
        "types": "./dist/extras.d.ts",
        "default": "./dist/extras.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.mts",
        "default": "./dist/react.mjs"
      },
      "require": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.cjs"
      }
    },
    "./vue": {
      "import": {
        "types": "./dist/vue.d.mts",
        "default": "./dist/vue.mjs"
      },
      "require": {
        "types": "./dist/vue.d.ts",
        "default": "./dist/vue.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup && node scripts/size.mjs",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "node scripts/size.mjs",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "^21.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "^5.0.4",
    "vue": "3.5.44"
  },
  "engines": {
    "node": ">=18"
  }
}
